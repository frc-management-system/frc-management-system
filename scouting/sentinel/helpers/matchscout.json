{
    "screens":
    {
        "auto":{
            "title": "Screen 1",
            "components": 
            {
                "type": "surface",
                "props": {"style":{"flex": 1,"width": "100%", "justifyContent": "center", "alignItems": "center"}},
                "children": [
                    {
                        "type": "card",
                        "props": {"style":{"flex": 1, "flexGrow": 1 , "alignItems": "space-between", "margin": 20}},
                        "children": [
                            {
                                "type": "cardActions",
                                "props":{"style": {"flexDirection":"row", "flexWrap": "wrap", "justifyContent": "center"}},
                                "children": 
                                [
                                    {
                                        "type": "radioButton",
                                        "field": "leave",
                                        "props": 
                                        {
                                            "style": {"flex":1},
                                            "onPress": [{"eventType": "ChangeRadioState", "field": "leave", "logCurrentRobotState": true}]
                                        }
                                    },
                                    {
                                        "type": "button",
                                        "field": "clearAlgae",
                                        "props":
                                        {
                                            "style": {"flex": 1, "margin": 20},
                                            "onPress": [{"eventType": "IncrementField", "field":"clearAlgae", "logCurrentRobotState": true }]
                                        },
                                        "children": "Button Name"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "text",
                        "props": 
                        {
                            "style":
                            {
                                "flex": 1,
                                "fontSize": 20,
                                "color": "#FFFFFF",
                                "textAlign": "center"
                            }
                        },
                        "children": "Text Here"
                    }
                ]
            }
        },
        "teleop1":{
            "title": "Test Screen 2",
            "components":
            {
                "type": "surface",
                "props": {"style":{"flex": 1, "flexDirection": "column", "justifyContent": "center", "alignItems": "center"}},
                "children": 
                [
                    {"type": "text", "props": {"value": "Text box name"}},
                    {"type": "button", "props": { "mode": "contained", "onPress": "handleEvent('clearAlgae');"}}
                ]
            }
        }
    },
    "robotState":
    {
        "actionType": "start",
        "location": "",
        "gamePiece": "",
        "miss": "",
        "leave": "unchecked",
        "notes": "",
        "clearAlgae": 0,
        "defenseRating": 0,
        "hasCoral": false,
        "hasAlgae": false
    },
    "logFields":
    [
        "actionType",
        "location",
        "gamePiece",
        "miss",
        "leave",
        "notes",
        "clearAlgae",
        "defenseRating"
    ]
}