{
    "screens":
    {
        "auto":{
            "title": "Screen 1",
            "components": 
            {
                "type": "view",
                "props": {"style":{"flexDirection": "column", "justifyContent": "center", "alignItems": "center"}},
                "children": [
                    {
                        "type": "card",
                        "props": {"flex": 1, "margin": 20},
                        "children": [
                            {
                                "type": "cardActions",
                                "props":{"style": {"flex":1}},
                                "children": 
                                [
                                    {
                                        "type": "radioButton",
                                        "props": 
                                        {
                                            "style": {"margin": 20},
                                            "value": "leave",
                                            "status": "currentMatchState.robotState.leave",
                                            "onPress": {"eventType": "ChangeRadioStatus", "field": "leave", "logCurrentRobotState": false}
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "text",
                        "props": 
                        {
                            "style":
                            {
                                "flex": 1,
                                "fontSize": 20,
                                "color": "#000000",
                                "textAlign": "center"
                            }
                        },
                        "children": "Text Here"
                    },
                    {
                        "type": "button",
                        "props":
                        {
                            "mode":  "contained",
                            "onPress": "handleEvent('clearAlgae');"
                        },
                        "children": "Button Name"
                    }
                ]
            }
        },
        "teleop1":{
            "title": "Test Screen 2",
            "components":
            {
                "type": "view",
                "props": {"style":{"flex": 1, "flexDirection": "column", "justifyContent": "center", "alignItems": "center"}},
                "children": 
                [
                    {"type": "text", "props": {"value": "Text box name"}},
                    {"type": "button", "props": { "mode": "contained", "onPress": "handleEvent('clearAlgae');"}}
                ]
            }
        }
    },
    "robotState":
    {
        "actionType": "start",
        "timestamp": 0,
        "location": "",
        "gamePiece": "",
        "miss": "",
        "leave": "unchecked",
        "notes": "",
        "clearAlgae": 0,
        "defenseRating": 0
    }
}