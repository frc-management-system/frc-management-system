{
    "screens":
    {
        "auto":{
            "title": "Screen 1",
            "components": 
            {
                "type": "surface",
                "props": {"style":{"flexDirection": "column", "height": "100%","width": "100%", "justifyContent": "center", "alignItems": "center"}},
                "children": [
                    {
                        "type": "card",
                        "props": {"style":{"flex": 3, "flexGrow": 1 , "alignSelf": "stretch"}},
                        "children": [
                            {
                                "type": "cardActions",
                                "props":{"style": {"flexDirection":"row", "flexWrap": "wrap", "justifyContent": "center"}},
                                "children": 
                                [
                                    {
                                        "type": "radioButton",
                                        "field": "leave",
                                        "props": 
                                        {
                                            "style": {"flex":1},
                                            "onPress": [{"eventType": "ChangeRadioState", "field": "leave", "logCurrentRobotState": true}]
                                        }
                                    },
                                    {
                                        "type": "button",
                                        "field": "clearAlgae",
                                        "props":
                                        {
                                            "style": {"flex": 1, "margin": 20},
                                            "onPress": [{"eventType": "IncrementField", "field":"clearAlgae", "logCurrentRobotState": true }]
                                        },
                                        "children": "Button Name"
                                    },
                                    {
                                        "type": "textInput",
                                        "field": "matchNum",
                                        "props": {
                                            "style":{"flex": 1},
                                            "isMatchInfo": "true",
                                            "disabled": "true",
                                            "label": "Match Number"
                                        }
                                    },
                                    {
                                        "type": "text",
                                        "field": "matchNum",
                                        "props": { "style": {"flex": 1}, "isMatchInfo": "true"},
                                        "children": "wrong field"
                                    },
                                    {
                                        "type": "text",
                                        "field": "teamNum",
                                        "props": {"style":{"flex": 1}, "isMatchInfo": "true"},
                                        "children": "wrong field"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "text",
                        "field":"",
                        "props": 
                        {
                            "style":
                            {
                                "flex": 1,
                                "fontSize": 20,
                                "color": "#FFFFFF",
                                "textAlign": "center"
                            }
                        },
                        "children": "Text Here"
                    }
                ]
            }
        },
        "teleop1":{
            "title": "Test Screen 2",
            "components":
            {
                "type": "surface",
                "props": {"style":{"flex": 1, "flexDirection": "row", "justifyContent": "center", "alignItems": "center"}},
                "children": 
                [
                    {"type": "text", "field":"", "props": {"style": {"flex":1}}, "children":"Page 2 Text"},
                    {"type": "button", "props": { "style":{"flex":1}}, "children":"Button Name"}
                ]
            }
        },
        "endgame":{
            "title": "endgame screen",
            "components":
            {
                "type": "surface",
                "props": {"style":{"flex": 1, "flexDirection": "row", "justifyContent": "center", "alignItems": "center"}},
                "children": 
                [
                    {"type": "text","field": "", "props": {"style": {"flex":1}}, "children":"Page 3 Text"},
                    {"type": "button", "props": { "style":{"flex":1}}, "children":"endgame button"}
                ]
            }
        }
    },
    "robotState":
    {
        "actionType": "start",
        "location": "",
        "gamePiece": "",
        "miss": "",
        "leave": "unchecked",
        "notes": "",
        "clearAlgae": 0,
        "defenseRating": 0,
        "hasCoral": false,
        "hasAlgae": false
    },
    "logFields":
    [
        "actionType",
        "location",
        "gamePiece",
        "miss",
        "leave",
        "notes",
        "clearAlgae",
        "defenseRating"
    ]
}